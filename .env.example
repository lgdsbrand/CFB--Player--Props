# =============================================================================
# Environment template — copy to .env (worker) and web/.env.local (app).
#
# NEVER commit a filled-in copy. .gitignore excludes .env and .env.local; this
# file is the only env file that belongs in git, and it must contain no real
# values (CLAUDE.md §0).
#
# Credential split, which is deliberate:
#   * The Next.js app gets the anon key ONLY. It reads; it never writes, and it
#     never calls a data provider directly.
#   * The service role key and the direct database URL live ONLY in the worker's
#     environment. If either reaches the browser bundle, rotate it.
# =============================================================================

# -----------------------------------------------------------------------------
# Web app (also copy these two into web/.env.local)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ variables are inlined into the client bundle — anon key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Worker — required
# -----------------------------------------------------------------------------
# Postgres connection. Supabase dashboard → Connect → Connection string.
#
# Use the SESSION POOLER (port 5432, host aws-N-<region>.pooler.supabase.com):
#   postgresql://postgres.<project-ref>:<password>@aws-N-<region>.pooler.supabase.com:5432/postgres
#
# Why session mode specifically, not the other two options:
#   * The DIRECT connection (db.<ref>.supabase.co) is IPv6-only unless you buy
#     the IPv4 add-on, and Render's outbound is not reliably IPv6.
#   * The TRANSACTION pooler (port 6543) is PgBouncer-style. psycopg3
#     automatically switches to server-side prepared statements after a few
#     executions, which that mode does not support — the backfill would start
#     failing partway through with confusing errors. If you must use 6543, add
#     ?prepare_threshold=0 to the URL.
# Session mode is IPv4 and supports the full protocol, which is what a
# long-running bulk-loading worker wants.
SUPABASE_DB_URL=

# CollegeFootballData API key. Assumed to be a PAID tier: the free tier rate
# limits too hard for a multi-season all-FBS backfill (CLAUDE.md §4).
# https://collegefootballdata.com/key
CFBD_API_KEY=

# -----------------------------------------------------------------------------
# Worker — optional now, needed by later phases
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The Odds API (the-odds-api.com). Needed from Phase 3a onward: the probe job
# `python -m worker.jobs.probe_odds` measures whether this plan covers NCAAF
# player props, what a weekly refresh costs, and whether HISTORICAL prop odds
# are reachable — the last of which decides whether the Phase 3 backtest can
# grade edge or only model calibration.
#
# Ingestion stays a pluggable adapter and the app degrades gracefully without a
# key: app_config.odds_adapter = "none" still produces model leans with no book
# line attached (CLAUDE.md §7, §9.1).
#
# NOTE: this provider authenticates via a QUERY PARAMETER, so request URLs are
# secret-bearing. Everything logged goes through worker.adapters.odds.http.redact.
#
# ODDS_API_KEY should hold the PAID key (20k credits/month). That allowance is a
# shared pool across the client's other models and has already been exhausted
# once mid-month, so put the free-tier key (500/month) in ODDS_API_KEY_FREE and
# run dry runs with `python -m worker.jobs.probe_odds --free`. Proving the
# adapter works should not be able to spend production credits by accident.
ODDS_API_KEY=
ODDS_API_KEY_FREE=

# Phase 5. Weekly cached AI reads — one call per player per week, never per
# page view (CLAUDE.md §2, §10). Roughly 1,700 players in a busy week.
#
# The client has Gemini and Grok; there is NO Anthropic or OpenAI key. Which
# provider actually runs is decided by `app_config.ai_adapter`, not by which of
# these is filled in — leaving both blank is a supported state and the app keeps
# rendering its empty read slot.
#
# GEMINI is the recommended one: it has a free tier the pipeline can be proven
# on before the client pays, and a Batch API suited to a weekly burst of ~1,700
# latency-insensitive calls. Note Google's FREE tier trains on submitted
# content and the paid tier does not — these prompts carry the client's model
# projections, so enable billing before generating anything real.
GEMINI_API_KEY=
GROK_API_KEY=

# Phase 5d. Where pipeline alerts go.
#
# OPTIONAL, AND LEAVING IT BLANK IS A WORKING CONFIGURATION. The default alert
# adapter (`app_config.alert_adapter = "log"`) writes findings to the run log,
# and `monitor_pipeline` exits non-zero on anything critical so Render's own
# cron-failure notification fires. That path needs no setup and cannot be broken
# by ours.
#
# Fill this in only when switching `app_config.alert_adapter` to "webhook". Any
# incoming webhook accepting `{"text": …}` works — Slack, Discord, Teams.
#
# THE WHOLE URL IS THE CREDENTIAL: a Slack webhook URL carries its secret in the
# path, so anyone holding it can post as that integration. It belongs here and
# NOT in app_config, which is world-readable under RLS (CLAUDE.md §0).
ALERT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Deployment, once
# -----------------------------------------------------------------------------
# The DESTINATION for `python -m worker.jobs.migrate_database` — the production
# database that the development one gets copied into (docs/deployment.md step 5).
# Same shape and the same session-pooler reasoning as SUPABASE_DB_URL above.
#
# This is the only variable that names a database the worker is allowed to
# TRUNCATE, which is why it is a separate name rather than an argument: nothing
# else reads it, and a machine that does not have it set cannot destroy a
# production table by mistyping a flag. Set it for the migration, then take it
# back out. Render never needs it.
#
# `migrate_database` with no arguments prints the plan and writes nothing, and
# `--self-test` proves the copy path without a target at all.
MIGRATION_TARGET_DB_URL=

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
